# IDE / editor
.vscode/
*.code-workspace
.idea/

# Data directory (mounted at runtime, not baked into image)
data/

# Training data / models (large, mounted separately)
TrainingSet4/
Great models/
Conversation/

# Misc
*.deb
*.deb.*
